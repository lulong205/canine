<%= render(FormFieldComponent.new(label: "Webhook URL", description: "Canine POSTs JSON (format v1) to this URL. Put a secret in the URL.")) do %>
  <input type="url" name="notifier[webhook_url]" value="<%= notifier&.webhook_url %>" class="input input-bordered w-full font-mono text-sm" placeholder="https://example.com/hooks/<secret>" />
<% end %>

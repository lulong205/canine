<%= content_for :title, "Logs" %>

<%= project_layout(@project) do %>
  <%# A full page visit (not frame-targeted), so the frame is re-rendered with the new Auto-refresh setting %>
  <%= form_with url: project_logs_path(@project), method: :get, class: "flex flex-wrap items-end gap-2 mb-4" do |form| %>
    <%= form.select :service, [ [ "All services", "" ] ] + @services, { selected: @service }, class: "select select-bordered select-sm" %>
    <%= form.search_field :q, value: @q, placeholder: "Search", maxlength: 200, class: "input input-bordered input-sm w-64" %>
    <%= form.select :range, K8::VictoriaLogs::RANGES, { selected: @range }, class: "select select-bordered select-sm" %>
    <label class="label cursor-pointer gap-2">
      <%= form.check_box :live, { checked: @live, class: "checkbox checkbox-sm" }, "1", "0" %>
      <span class="label-text">Auto-refresh</span>
    </label>
    <%= form.submit "Search", class: "btn btn-primary btn-sm", name: nil %>
  <% end %>

  <% frame_data = @live ? { controller: "refresh-turbo-frame", refresh_turbo_frame_frequency_value: 10000 } : {} %>
  <%= turbo_frame_tag "logs", data: frame_data do %>
    <% if @endpoint.nil? && @error.nil? %>
      <div class="alert alert-info">
        <iconify-icon icon="lucide:info"></iconify-icon>
        <span>VictoriaLogs isn't installed on this cluster. <%= link_to "Install it from the cluster's packages", edit_cluster_path(@project.cluster), class: "link", data: { turbo_frame: "_top" } %>.</span>
      </div>
    <% elsif @error %>
      <div class="alert alert-warning">
        <iconify-icon icon="lucide:alert-triangle"></iconify-icon>
        <span><%= @error %></span>
      </div>
    <% elsif @rows.empty? %>
      <p class="text-sm text-gray-500">No logs in the last <%= @range %>.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="table table-xs font-mono">
          <tbody>
            <% @rows.each do |row| %>
              <tr class="align-top">
                <td class="whitespace-nowrap text-gray-500"><%= row[:time]&.strftime("%Y-%m-%d %H:%M:%S.%L") %></td>
                <td><% if row[:service] %><span class="badge badge-sm badge-ghost"><%= row[:service] %></span><% end %></td>
                <td class="whitespace-nowrap text-gray-500"><%= row[:pod] %></td>
                <td class="whitespace-pre-wrap break-all"><%= row[:message] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @rows.size >= K8::VictoriaLogs::LIMIT %>
        <p class="text-sm text-gray-500 mt-2">Showing the newest 500 lines. Narrow the search to see older ones.</p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
